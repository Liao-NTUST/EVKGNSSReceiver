<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 以上的雲端備份與裝置轉移規則：MQTT / NTRIP 設定可能含密碼，不備份也不轉移。 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="mqtt_settings.xml" />
        <exclude domain="sharedpref" path="ntrip_settings.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="mqtt_settings.xml" />
        <exclude domain="sharedpref" path="ntrip_settings.xml" />
    </device-transfer>
</data-extraction-rules>
